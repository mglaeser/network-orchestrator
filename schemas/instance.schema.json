{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance",
    "namespace",
    "framework",
    "host",
    "names",
    "workloads",
    "port_ranges",
    "transport",
    "discovery",
    "supervision",
    "lifecycle_tools",
    "decisions",
    "acceptance",
    "deviations",
    "authoring"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1
      ]
    },
    "instance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]{0,127}$"
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "artifact_sha256",
        "revision",
        "dependency_lock_sha256",
        "schema_version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
        },
        "artifact_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "dependency_lock_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "enum": [
            1
          ]
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account",
        "lan",
        "runtime",
        "platform",
        "baseline"
      ],
      "properties": {
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uid",
            "gid",
            "home"
          ],
          "properties": {
            "uid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "gid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "home": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\x00\\n\\r]+$"
            }
          }
        },
        "lan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hardware_id",
            "link",
            "ipv4",
            "cidr"
          ],
          "properties": {
            "hardware_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "link": {
              "enum": [
                "wired",
                "wifi"
              ]
            },
            "ipv4": {
              "type": "string",
              "minLength": 1,
              "maxLength": 15
            },
            "cidr": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "version"
          ],
          "properties": {
            "network": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
            }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "macos_version",
            "macos_build"
          ],
          "properties": {
            "macos_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[a-z0-9.-]+)?$"
            },
            "macos_build": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[A-Za-z0-9]{3,32}$"
            }
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filevault",
            "automatic_login",
            "power_restart",
            "application_firewall",
            "network_extensions",
            "proxies",
            "vpns",
            "internet_sharing"
          ],
          "properties": {
            "filevault": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "automatic_login": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "power_restart": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "application_firewall": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "network_extensions": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "proxies": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "vpns": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "internet_sharing": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinator_label",
        "bonjour_label",
        "supervisor_label",
        "pf_label",
        "pf_anchor",
        "helper_label",
        "state_directory",
        "root_state_directory",
        "bonjour_prefix",
        "import_prefix"
      ],
      "properties": {
        "coordinator_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bonjour_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "supervisor_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pf_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pf_anchor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^com\\.apple/[a-z][a-z0-9./-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "helper_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_directory": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\x00\\n\\r]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "root_state_directory": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\x00\\n\\r]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bonjour_prefix": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "import_prefix": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "workloads": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "application_profile",
          "contract",
          "automatic_port_range",
          "recovery",
          "components"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "application_profile": {
            "enum": [
              "generic",
              "resolver",
              "reverse-proxy",
              "home-assistant",
              "media-controller",
              "camera",
              "dashboard",
              "inference",
              "management-ui"
            ]
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "data_path"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              },
              "data_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*\\.json$"
              }
            }
          },
          "automatic_port_range": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "recovery": {
            "enum": [
              "manual-only",
              "proven-stopped",
              "disabled"
            ]
          },
          "components": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "health",
                "recovery"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "health": {
                  "enum": [
                    "existing-owner"
                  ]
                },
                "recovery": {
                  "enum": [
                    "none",
                    "component-owner",
                    "supervisor-ensure"
                  ]
                }
              }
            }
          },
          "deadlines": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "probe_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              },
              "action_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              }
            }
          }
        }
      }
    },
    "port_ranges": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "first",
          "last"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "last": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "transport": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "service",
          "strategy",
          "version",
          "protocol",
          "ports",
          "target_ports",
          "dependencies",
          "fallback_publication"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "strategy": {
            "enum": [
              "published-port",
              "host-port-redirect",
              "guest-direct-redirect",
              "guest-udp-range-forward",
              "guest-lan-alias"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "protocol": {
            "enum": [
              "tcp",
              "udp",
              "ipv4"
            ]
          },
          "ports": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "range"
                    ],
                    "properties": {
                      "range": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[a-z][a-z0-9-]{0,63}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "first",
                      "last"
                    ],
                    "properties": {
                      "first": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "last": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "target_ports": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "range"
                    ],
                    "properties": {
                      "range": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[a-z][a-z0-9-]{0,63}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "first",
                      "last"
                    ],
                    "properties": {
                      "first": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "last": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "dependencies": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "fallback_publication": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_scope": {
            "enum": [
              "any"
            ]
          }
        }
      }
    },
    "discovery": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "service",
          "profile",
          "version",
          "direction",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "profile": {
            "enum": [
              "published-tcp-export",
              "homekit-export",
              "home-assistant-export",
              "apple-media-import"
            ]
          },
          "version": {
            "enum": [
              1
            ]
          },
          "service_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 69,
              "pattern": "^_[A-Za-z0-9][A-Za-z0-9-]{0,62}\\._tcp$"
            }
          },
          "direction": {
            "enum": [
              "import",
              "export"
            ]
          },
          "return_path": {
            "enum": [
              "independent"
            ]
          },
          "dependencies": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "misses": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      }
    },
    "supervision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supervisor",
        "reconcile_seconds",
        "health_seconds",
        "discovery_seconds",
        "discovery_misses",
        "read_timeout_seconds",
        "failure_exit_code"
      ],
      "properties": {
        "supervisor": {
          "enum": [
            "monit"
          ]
        },
        "reconcile_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "health_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "discovery_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "discovery_misses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "read_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "failure_exit_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 125
        },
        "component_exit_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 125
        },
        "restart_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "starts",
            "window_seconds"
          ],
          "properties": {
            "starts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "window_seconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            }
          }
        },
        "action_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "lifecycle_tools": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "container_api_access",
          "starts_runtime",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "enum": [
              "vendor-cli",
              "api-bridge",
              "management-ui",
              "application-manager",
              "installer",
              "supervisor"
            ]
          },
          "container_api_access": {
            "type": "boolean"
          },
          "starts_runtime": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "starts_fleet": {
            "const": true
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded",
        "unattended_recovery",
        "import_visibility",
        "lifecycle_control"
      ],
      "properties": {
        "bounded": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "max_age_seconds",
              "unknown_limit",
              "residual",
              "signed_by",
              "signed_at"
            ],
            "properties": {
              "profile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "max_age_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              },
              "unknown_limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "residual": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "signed_by": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "signed_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20,
